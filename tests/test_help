source $RUNNER_ROOT/tests/lib.sh

####################################################################################################
# Happy path: default help target displays targets, variables, and tips across all scopes.
####################################################################################################

function happy_path_default_help {
  local test_case_name=${FUNCNAME[0]}
  local actual_value_filename=${test_case_name}.actual.log
  bmakelib.test.cat <<'EOF' > Makefile
SHELL := /usr/bin/env bash
include $(bmakelib.ROOT)/bmakelib.mk

MY_VAR ?= test-val ## A sample configuration variable

my-target : ## Build a sample target
	@echo "running my-target"
EOF

  make help > $actual_value_filename 2>&1

  local expexted_pattern_filename=${test_case_name}.expected.pattern
  bmakelib.test.cat <<'EOF' > $expexted_pattern_filename
make.+Entering.+
={80}
  LOCAL: defined in the source tree
={80}

  TARGETS
    my-target  Build a sample target

  VARIABLES
(?:\s+[^\n]+\n)+
={80}
  INCLUDED: imported from included makefiles
={80}

  TARGETS
    bmakelib.help  Extracts and displays available targets and variables along with their documentation.
    help           Convenience target with a shorter and more intuitive name\..*

  VARIABLES
(?:\s+[^\n]+\n)+
(?:={80}\n  BUILTIN: predefined by GNU Make\n={80}\n\n  TARGETS\n(?:\s+[^\n]+\n)+)?
-{80}
Notes:
- Run 'env' to view the environment variables passed to Make.
- Use 'bmakelib.conf.help.scope=local\|included\|builtin\|all' to control the scope.
- Use 'bmakelib.conf.help.targets=no' to skip targets.
- Use 'bmakelib.conf.help.variables=no' to skip variables.
- Use 'bmakelib.conf.help.tips=no' to silence this tip.
make.+Leaving.+
EOF

  bmakelib.test.assert_matches $test_case_name $actual_value_filename $expexted_pattern_filename \
    || return 1
}

