####################################################################################################
# Convenience target configuration: convenience-target=no prevents defining 'help'.
####################################################################################################

function when_convenience_target_is_no {
  local test_case_name=${FUNCNAME[0]}
  local actual_value_filename=${test_case_name}.actual.log
  bmakelib.test.cat <<'EOF' > Makefile
SHELL := /usr/bin/env bash
bmakelib.conf.help.convenience-target := no
include $(bmakelib.ROOT)/bmakelib.mk

MY_VAR ?= test-val ## A sample configuration variable

my-target : ## Build a sample target
	@echo "running my-target"
EOF

  make help > $actual_value_filename 2>&1
  make bmakelib.conf.help.scope=local bmakelib.help >> $actual_value_filename 2>&1

  local expexted_pattern_filename=${test_case_name}.expected.pattern
  bmakelib.test.cat <<'EOF' > $expexted_pattern_filename
make.+Entering.+
.+\*\*\*\s+No rule to make target 'help'\.\s+Stop\.
make.+Leaving.+
make.+Entering.+
={80}
  LOCAL: defined in the source tree
={80}

  TARGETS
    my-target  Build a sample target

  VARIABLES
(?:\s+[^\n]+\n)+
-{80}
Notes:
- Run 'env' to view the environment variables passed to Make.
- Use 'bmakelib.conf.help.scope=local\|included\|builtin\|all' to control the scope.
- Use 'bmakelib.conf.help.targets=no' to skip targets.
- Use 'bmakelib.conf.help.variables=no' to skip variables.
- Use 'bmakelib.conf.help.tips=no' to silence this tip.
make.+Leaving.+
EOF

  bmakelib.test.assert_matches $test_case_name $actual_value_filename $expexted_pattern_filename \
    || return 1
}

####################################################################################################
# Mixed documentation styles: bmakelib docblocks and inline ## comments.
####################################################################################################

function docblock_and_inline_mixed_styles {
  local test_case_name=${FUNCNAME[0]}
  local actual_value_filename=${test_case_name}.actual.log
  bmakelib.test.cat <<'EOF' > Makefile
SHELL := /usr/bin/env bash
include $(bmakelib.ROOT)/bmakelib.mk

#>
#   # `block-target`
#
#   Target documented using structured bmakelib docblock.
#<
block-target :
	@echo "block target"

inline-target : ## Target documented using inline double-hash.
	@echo "inline target"
EOF

  make bmakelib.conf.help.scope=local bmakelib.conf.help.variables=no bmakelib.conf.help.tips=no help > $actual_value_filename 2>&1

  local expexted_pattern_filename=${test_case_name}.expected.pattern
  bmakelib.test.cat <<'EOF' > $expexted_pattern_filename
make.+Entering.+
={80}
  LOCAL: defined in the source tree
={80}

  TARGETS
    block-target   Target documented using structured bmakelib docblock\.
    inline-target  Target documented using inline double-hash\.

make.+Leaving.+
EOF

  bmakelib.test.assert_matches $test_case_name $actual_value_filename $expexted_pattern_filename \
    || return 1
}

